# Copiad este fichero a .env y cambiad todas las claves. .env no va al repositorio (DS3).
# docker compose lee .env solo, y lo usa donde compose.yaml pone ${NOMBRE}.
# Las claves sin cambiar valen «cambiar»: instalar.sh tiene que parar si queda alguna.

# Base de datos
DB_NOMBRE=
DB_USUARIO=
DB_CLAVE=cambiar

# Usuario de la intranet
INTRANET_USUARIO=
INTRANET_CLAVE=cambiar
