# Copiad este fichero a .env y cambiad todas las claves. .env no va al repositorio (DS3).
# docker compose lee .env solo, y lo usa donde compose.yaml pone ${NOMBRE}.
# Las claves sin cambiar valen «cambiar»: instalar.sh tiene que parar si queda alguna.
#
# Sugerencia: generar una clave fuerte con   openssl rand -hex 16

# Base de datos (ASGBD · D1-D3)
# DB_USUARIO es el administrador (POSTGRES_USER, admin_sede en la teoría):
# solo entra por el socket, con docker compose exec. Nunca por red.
DB_NOMBRE=sede
DB_USUARIO=sede
DB_CLAVE=cambiar

# Rol propio de la web: solo lee clientes en DB_NOMBRE (db/init/03-claves.sh)
WEB_USUARIO=web
WEB_CLAVE=cambiar

# Reto 1 · base bifi (db/init/02-bifi.sql y 03-claves.sh)
PANEL_CLAVE=cambiar                   # rol panel: el panel del BIFI desde Compose
RESP_DEMO_CLAVE=cambiar               # rol resp_demo: un responsable con psql desde el aula

# Usuario y contraseña de la intranet (auth basic de Apache, IAW)
INTRANET_USUARIO=alumno
INTRANET_CLAVE=cambiar

# --- Lo de debajo lo escribe instalar.sh desde sede.env: no lo toquéis aquí ---
