[Unit]
Description=NAT de la sede (tabla sede_nat, no toca las reglas de Docker)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# La línea "table ip sede_nat" es idempotente: recargar reemplaza solo esa tabla.
ExecStart=/usr/sbin/nft -f /etc/nftables.d/sede-nat.conf
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
