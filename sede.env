# Datos de la sede (DS4). No son secretos: van en Git.
# Es el único sitio donde aparecen. Si un fichero de configuración los necesita, se toman de aquí.
# Formato NOMBRE=valor, sin espacios alrededor del =.
#
# Para probar en otra red (p. ej. una VM) sin tocar este fichero: copiad las
# líneas que cambien a sede.local.env (no va en Git); instalar.sh lo lee después.
SEDE=calatayud
DOMINIO=calatayud.empresa.lan
INTERFAZ_AULA=enp5s0
IP_AULA=192.168.6.118
RED_AULA=192.168.6.0/24
PUERTA_AULA=192.168.6.1
RESOLUTOR_CENTRO=192.168.6.98
# La red interna va por la MISMA tarjeta que el aula (segunda IP en enp5s0,
# ver red/netplan/99-sede.yaml). Comprobad el nombre con `ip a` en el servidor.
INTERFAZ_INTERNA=enp5s0
RED_INTERNA=10.4.0.0/24
IP_INTERNA=10.4.0.1
